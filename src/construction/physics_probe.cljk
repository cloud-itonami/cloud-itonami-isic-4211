(ns construction.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  concrete test-cylinder compression-press simulation
  (`construction.simphysics/press-telemetry`, ASTM C39 / EN 12390-3) over a
  fixed sweep of specimen heights and print ONE EDN map of the physical
  quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-4211/SOUL.md)
  reads every tick. Every number is derived from time-stepped trajectories
  by `construction.simphysics`, never typed in. Output schema
  `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-4211\"
     :procedure \"...\"
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n               ; runs that produced numeric quantities
     :expected  n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [construction.robotics :as robotics]
            [construction.simphysics :as simphysics]))

(def schema "itonami.physical-ai.probe.v1")

(def fc-mpa
  "Design-mix rated strength every `construction.store` fixture site carries."
  30.0)

(def diameter-mm
  "Standard ASTM C39 / EN 12390-3 cylinder diameter every fixture carries."
  150.0)

(def sweep-heights-mm
  "Specimen heights swept each tick (L/D 1.0 .. 3.0 at 150 mm diameter).
  300 mm (standard, L/D 2) and 150 mm (the short-specimen site) are the
  heights `construction.store` seeds; the others bracket them so a solver
  change shows up as a change in slope, not only in one point."
  [150.0 225.0 300.0 375.0 450.0])

(defn- site [height-mm]
  {:design-mix-rated-strength-mpa fc-mpa
   :cylinder-height-actual-mm height-mm
   :cylinder-diameter-actual-mm diameter-mm})

(defn- strength-at [height-mm]
  (:sim-compressive-strength-mpa (robotics/press-telemetry-for (site height-mm))))

(defn- run-one [height-mm]
  (let [s (site height-mm)
        t (robotics/press-telemetry-for s)]
    {:input s
     :quantities (assoc t :l-over-d (/ height-mm diameter-mm))
     :out-of-tolerance? (robotics/press-out-of-tolerance? (merge s t))}))

(defn- bisect
  "Boundary of monotone predicate `ok?` on [lo hi] where exactly one end is
  ok: returns the ok-side endpoint after `iters` halvings."
  [ok? lo hi iters]
  (loop [lo lo hi hi i 0]
    (if (>= i iters)
      (if (ok? lo) lo hi)
      (let [mid (/ (+ lo hi) 2.0)]
        (if (= (ok? mid) (ok? lo))
          (recur mid hi (inc i))
          (recur lo mid (inc i)))))))

(defn passing-height-band-mm
  "[min max] specimen height (mm, at `diameter-mm`, `fc-mpa`) whose simulated
  compressive strength stays inside [ACI 318 floor, sanity ceiling], each
  edge by bisection over the REAL simulation (strength falls monotonically
  with height -- pinned by physics_probe_test). nil when the bracket
  [lo hi] does not contain the passing band with failing ends."
  ([] (passing-height-band-mm 50.0 1000.0 40))
  ([lo hi iters]
   (let [floor (simphysics/strength-floor-mpa fc-mpa)
         ceiling (simphysics/strength-ceiling-mpa fc-mpa)
         under-ceiling? (fn [h] (<= (strength-at h) ceiling))
         over-floor? (fn [h] (>= (strength-at h) floor))
         nominal simphysics/nominal-height-mm]
     (when (and (not (under-ceiling? lo)) (under-ceiling? nominal)
                (not (over-floor? hi)) (over-floor? nominal))
       [(bisect under-ceiling? lo nominal iters)
        (bisect over-floor? nominal hi iters)]))))

(defn probe []
  (let [runs (mapv run-one sweep-heights-mm)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-compressive-strength-mpa])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-4211"
     :procedure "ASTM C39 / EN 12390-3 concrete test-cylinder compressive strength (robot placement-verification cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:fc-mpa fc-mpa
               :strength-floor-mpa (simphysics/strength-floor-mpa fc-mpa)
               :strength-ceiling-mpa (simphysics/strength-ceiling-mpa fc-mpa)
               :passing-height-band-mm (passing-height-band-mm)}
     :count (count (filter numeric? runs))
     :expected (count sweep-heights-mm)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
